# Patient-derived data and experiment artifacts must never be committed.
# Leading slashes anchor these to the repository root, so source packages such
# as src/ais_progression/models/ stay tracked.
/data/
/outputs/
/models/
/weights/
/checkpoints/
/artifacts/
/runs/
/logs/
/handoff/

# Model and training artifacts
*.ckpt
*.pth
*.pt
*.safetensors
*.onnx
*.joblib
events.out.tfevents.*

# Medical/raster images and tabular cohort files
*.dcm
*.dicom
*.nii
*.nii.gz
*.png
*.jpg
*.jpeg
*.bmp
*.tif
*.tiff
*.csv
*.tsv
*.xls
*.xlsx
*.parquet

# Only synthetic schema examples are allowed.
!examples/*.csv

.venv/
__pycache__/
*.egg-info/
lightning_logs/
*.pyc
.pytest_cache/
.ruff_cache/
dist/
build/
.coverage
htmlcov/
.claude/settings.local.json
